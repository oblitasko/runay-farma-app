EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Alias aceptado por la app si el dashboard muestra "Publishable key":
# EXPO_PUBLIC_SUPABASE_KEY=your-anon-or-publishable-key

# Solo CLI local. No uses el prefijo EXPO_PUBLIC_ (no debe ir al bundle).
# SUPABASE_ACCESS_TOKEN=sbp_your-access-token
# SUPABASE_DB_PASSWORD=your-database-password
