{
  "expo": {
    "name": "RUNAY FARMA",
    "slug": "runay-farma-app",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "runayfarma",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F93B2A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.runayfarma.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F93B2A"
      },
      "package": "com.runayfarma.app",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-file-system",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
